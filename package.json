{
  "name": "tgcloud-mcp",
  "version": "0.2.0",
  "description": "MCP server for Telegram serverless bots (@tgcloud) — project lifecycle, deploys, migrations and webhooks through the tgcloud CLI",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "tgcloud-mcp": "bin/tgcloud-mcp.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "smoke": "node scripts/smoke-test.mjs",
    "setup": "node scripts/setup.mjs",
    "links": "node scripts/generate-install-links.mjs",
    "docs:check": "node scripts/check-docs-drift.mjs",
    "update": "node scripts/self-update.mjs",
    "test": "npm run build && npm run smoke && node tests/e2e.mjs",
    "prepublishOnly": "npm run test"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.1.0",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.7.0"
  },
  "files": [
    "dist",
    "bin",
    "resources",
    "skills",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "mcp",
    "telegram",
    "bots",
    "serverless",
    "tgcloud"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sdamarketing/tgcloud_mcp.git"
  },
  "homepage": "https://github.com/sdamarketing/tgcloud_mcp",
  "bugs": "https://github.com/sdamarketing/tgcloud_mcp/issues"
}
